{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env.local --import tsx server.ts",
    "start": "node --env-file-if-exists=.env.local dist-server/server.mjs",
    "build": "vite build && node scripts/build-server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-tuyendung-security \"node --import tsx --test tests/content-rules.emulator.test.ts\"",
    "migrate:applications": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-applications.ts",
    "admin:access": "node --env-file-if-exists=.env.local --import tsx scripts/admin-access.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@types/nodemailer": "^7.0.11",
    "@vitejs/plugin-react": "^5.0.4",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.17",
    "express": "^4.22.3",
    "firebase": "^12.10.0",
    "firebase-admin": "^14.5.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "nodemailer": "^10.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.4"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "postcss-selector-parser": "^7.1.6"
  }
}
