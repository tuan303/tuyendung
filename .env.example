# Never commit .env.local. VITE_* below are PUBLIC web configuration, not credentials.
# Production keeps the existing web Firebase defaults when all six overrides are blank.
# Preview/staging MUST supply ALL six values for a SEPARATE Firebase project.
# Set these at BUILD time. Partial overrides are rejected.
VITE_APP_ENV=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server-only. Never prefix secrets below with VITE_.
# APP_ENV=staging requires an explicit separate server project/bucket too.
APP_ENV=
APP_URL=https://your-recruitment-domain.example
FIREBASE_PROJECT_ID=graphic-pattern-482103-m6
FIREBASE_STORAGE_BUCKET=graphic-pattern-482103-m6.firebasestorage.app
# Choose JSON service account OR separate fields OR Google Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Independent random keys: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RATE_LIMIT_SALT=
SMTP_ENCRYPTION_KEY=
# Only these exact DNS hostnames may be used by the SMTP admin screen.
SMTP_ALLOWED_HOSTS=smtp.gmail.com

# Optional env-managed SMTP (read-only in admin). Otherwise save in private server settings.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_RECIPIENT=
# Required in preview/APP_ENV=staging; configured SMTP recipient must match exactly.
# Use a dedicated TEST inbox, never the operational HR inbox.
SMTP_TEST_RECIPIENT=

# Default is durable Firestore. File mode is allowed ONLY for explicit local development.
APPLICATION_STORE=firestore
# APPLICATION_DATA_DIR=/absolute/private/development-fixtures
# HOST=127.0.0.1
# PORT=3000
# Set only when your own reverse proxy overwrites all forwarded-IP headers.
TRUST_PROXY_HOPS=0
