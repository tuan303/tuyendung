{
  "version": 2,
  "functions": {
    "api/index.ts": { "maxDuration": 30, "excludeFiles": "data/**" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/backend-api/(.*)", "destination": "/api/index" },
    { "source": "/health", "destination": "/health" },
    { "source": "/ping", "destination": "/ping" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
